VITE_API_URL=http://localhost:4000

# Base URL ng upload link / QR scan.
# Kung walang value: auto-detect gamit ang LAN IP na pinag-bubuksan ng admin (e.g. http://192.168.100.7:4000),
# para ma-scan sa phone on same WiFi.
# Kung gusto mong i-pin sa isang deploy URL, i-uncomment at i-edit ito:
